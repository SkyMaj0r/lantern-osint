# Required. Sent in the User-Agent on every outbound request (SEC EDGAR
# returns 403 without a real contact) and used as the Lantern maintainer
# contact across sources that ask ToS compliance questions.
CONTACT_EMAIL=you@example.com

# Required to run the API. The CLI never reads this. The API authenticates
# every request with it, even local ones.
API_BEARER_TOKEN=change-me

# Optional. Only needed if/when the corresponding collector is enabled;
# every module degrades gracefully (logs + returns no findings) without it.
# Enables the optional virustotal module (IP and DOMAIN reputation).
# Free community API key, no card: https://www.virustotal.com/gui/join-us
VIRUSTOTAL_API_KEY=
HUDSONROCK_API_KEY=
# Enables the optional searchapi module (PERSON and DOMAIN queries only).
# Free tier: 100 searches TOTAL, one-time trial, does not reset monthly.
# https://www.searchapi.io/
SEARCHAPI_API_KEY=
# Enables the optional abuseipdb module (IP abuse/reputation reports).
# Free tier (1,000 checks/day, resets 00:00 UTC): https://www.abuseipdb.com/
ABUSEIPDB_API_KEY=

# Optional. Path to the SQLite response cache.
CACHE_PATH=lantern_cache.db
